# ====================================
# CupAI 环境变量配置模板
# 复制本文件为 .env 并填入实际值
# ====================================

# ---------- 全局配置 ----------
# 运行环境: development | production | test
NODE_ENV=development

# ---------- 数据库配置 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=cupai

# ---------- Redis 配置 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 后端服务配置 ----------
SERVER_PORT=3001
SERVER_API_PREFIX=/api/v1

# ---------- 前端配置 ----------
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_WS_URL=ws://localhost:3001

# ---------- JWT 配置 ----------
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRES_IN=7d

# ---------- AI 中转配置 ----------
# AI 调用超时时间（毫秒）
AI_REQUEST_TIMEOUT=60000
# AI 调用失败最大重试次数
AI_MAX_RETRIES=3

# ---------- 数据同步配置 ----------
# 赛事数据同步间隔（分钟）
DATA_SYNC_INTERVAL=60
# 舆情数据同步间隔（分钟）
SENTIMENT_SYNC_INTERVAL=30
